  "private": true,
  "scripts": {
    "content:build": "node --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-content.mts",
    "predev": "pnpm run content:build",
    "dev": "next dev",
    "prebuild": "pnpm run content:build && pnpm run validate:content",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
